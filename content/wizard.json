  "waarschuwingen": {
    "rommel": {
      "kop": "Eerst opruimen, dan pas kopen",
      "tekst": "Een robot die elke dag vastloopt op een kabel of sok wordt binnen een maand een dure deurstop. Zelfs de beste objectherkenning mist dingen. Kun je de vloer niet grotendeels vrijhouden, koop dan liever een goede steelstofzuiger — die is goedkoper en frustreert minder."
    },
    "roedes": {
      "kop": "Let op bij verdeeld glas",
      "tekst": "Raamrobots hebben een aaneengesloten glasvlak nodig om zich vast te zuigen. Ramen met roedes of smalle vlakken onder ongeveer 50 bij 50 centimeter zijn geen goede kandidaat. Meet je kleinste ruit voordat je bestelt."
    },
    "raam_perfectie": {
      "kop": "Verwacht geen glazenwassersresultaat",
      "tekst": "Elke raamrobot laat de randen en hoeken staan — daar kan hij fysiek niet komen zonder los te laten. Reken op tachtig procent van het werk uit handen, niet op honderd. Wil je écht streeploos glas, dan blijft een doek nodig."
    },
    "gps": {
      "kop": "Satellietnavigatie is hier riskant",
      "tekst": "Onder dichte bomen of vlak langs een hoge gevel verliezen RTK-maaiers hun signaal. Ze stoppen dan midden in de tuin. In zo'n tuin is een klassiek model met begrenzingsdraad gewoon betrouwbaarder, hoe ouderwets dat ook klinkt."
    },
    "opzetbad": {
      "kop": "Check eerst de bodem en wand",
      "tekst": "Veel robots zijn gemaakt voor harde wanden. Op een zacht opzetbad met een geplooide bodem krijgen ze geen grip en missen ze stukken. Voor een klein opzetbad is een handmatige stofzuiger op de tuinslang meestal verstandiger — en tien keer goedkoper."
    }
  }
